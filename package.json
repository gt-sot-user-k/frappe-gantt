{
    "name": "@gts-ui/chart-gantt",
    "version": "0.0.1",
    "description": "A lightweight, modern, and interactive Gantt chart library for building project timelines on the web.",
    "main": "dist/gantt.umd.js",
    "module": "dist/gantt.es.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build-dev": "vite build --watch",
        "build": "vite build && npm run build:types",
        "build:types": "tsc",
        "test": "vitest run",
        "lint": "eslint src/**/*.js",
        "prettier": "prettier --write \"{src/*,tests/*,rollup.config}.js\"",
        "prettier-check": "prettier --check \"{src/*,tests/*,rollup.config}.js\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.pge-energo.ru/gts-ui/libs/chart-gantt.git"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/gantt.umd.js",
            "import": "./dist/gantt.es.js"
        },
        "./style": "./dist/gantt.css"
    },
    "keywords": [
        "gantt chart",
        "gantt library",
        "gantt chart library",
        "gantt",
        "svg",
        "simple gantt",
        "project timeline",
        "interactive gantt",
        "project management"
    ],
    "author": "GTS",
    "license": "MIT",
    "bugs": {
        "url": "https://gitlab.pge-energo.ru/gts-ui/libs/chart-gantt/issues"
    },
    "homepage": "https://gitlab.pge-energo.ru/gts-ui/libs/chart-gantt",
    "devDependencies": {
        "@types/node": "^24.1.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^8.10.0",
        "eslint-plugin-prettier": "^5.5.3",
        "postcss-nesting": "^13.0.1",
        "prettier": "^3.2.5",
        "typescript": "^5.8.3",
        "vite": "^6.3.2",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    },
    "eslintIgnore": [
        "dist"
    ],
    "sideEffects": [
        "*.css"
    ]
}
